{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "LLM API 可用性与性能监控面板。探测 OpenAI / Anthropic / Google Gemini 及兼容 API 的连接延迟、首 Token 延迟（TTFT）、Token 生成速率和错误率。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "doc",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Design Doc",
      "type": "link",
      "url": "https://github.com/taosun/llm-exporter/blob/main/DESIGN.md"
    },
    {
      "asDropdown": false,
      "icon": "doc",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "README",
      "type": "link",
      "url": "https://github.com/taosun/llm-exporter/blob/main/README.md"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "title": "Status Map",
      "description": "所有目标的当前探测状态",
      "type": "stat",
      "id": 1,
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green", "index": 1 } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "llm_probe_success{provider=~\"$provider\", model=~\"$model\"}",
          "legendFormat": "{{ provider }} / {{ model }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Targets",
      "description": "配置的探测目标总数",
      "type": "stat",
      "id": 2,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "count(llm_probe_success{provider=~\"$provider\", model=~\"$model\"})", "refId": "A" }
      ]
    },
    {
      "title": "Online",
      "description": "当前探测成功的目标数量",
      "type": "stat",
      "id": 3,
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "count(llm_probe_success{provider=~\"$provider\", model=~\"$model\"} == 1) or vector(0)", "refId": "A" }
      ]
    },
    {
      "title": "Global Availability",
      "description": "所有目标的综合可用率（在线数 / 总数）",
      "type": "stat",
      "id": 4,
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "min": 0, "max": 1
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "(count(llm_probe_success{provider=~\"$provider\", model=~\"$model\"} == 1) or vector(0)) / count(llm_probe_success{provider=~\"$provider\", model=~\"$model\"})", "refId": "A" }
      ]
    },
    {
      "title": "Avg TTFT",
      "description": "所有目标的平均首 Token 延迟（Time to First Token）",
      "type": "stat",
      "id": 5,
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "avg(rate(llm_probe_ttft_seconds_sum{provider=~\"$provider\", model=~\"$model\"}[$__rate_interval]) / clamp_min(rate(llm_probe_ttft_seconds_count{provider=~\"$provider\", model=~\"$model\"}[$__rate_interval]), 1e-10))", "refId": "A" }
      ]
    },
    {
      "title": "Avg Connect",
      "description": "所有目标的平均连接耗时（DNS + TCP + TLS）",
      "type": "stat",
      "id": 50,
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "avg(rate(llm_probe_connect_duration_seconds_sum{provider=~\"$provider\", model=~\"$model\"}[$__rate_interval]) / clamp_min(rate(llm_probe_connect_duration_seconds_count{provider=~\"$provider\", model=~\"$model\"}[$__rate_interval]), 1e-10)) * 1000", "refId": "A" }
      ]
    },
    {
      "title": "Avg Token Rate",
      "description": "所有目标的平均 Token 生成速率（tok/s）",
      "type": "stat",
      "id": 51,
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "avg(llm_probe_token_rate{provider=~\"$provider\", model=~\"$model\"})", "legendFormat": "tok/s", "refId": "A" }
      ]
    },
    {
      "title": "Avg Duration",
      "description": "所有目标的平均完整请求时长（从发起到流结束）",
      "type": "stat",
      "id": 6,
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "avg(rate(llm_probe_duration_seconds_sum{provider=~\"$provider\", model=~\"$model\"}[$__rate_interval]) / clamp_min(rate(llm_probe_duration_seconds_count{provider=~\"$provider\", model=~\"$model\"}[$__rate_interval]), 1e-10))", "refId": "A" }
      ]
    },
    {
      "title": "Errors (5m)",
      "description": "最近 5 分钟内所有目标的错误总数",
      "type": "stat",
      "id": 7,
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "expr": "sum(increase(llm_probe_errors_total{provider=~\"$provider\", model=~\"$model\"}[5m])) or vector(0)", "refId": "A" }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "title": "Target Detail — $provider",
      "type": "row",
      "repeat": "provider",
      "repeatDirection": "h"
    },
    {
      "title": "Status",
      "description": "当前探测状态：UP 或 DOWN",
      "type": "stat", "id": 10,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green", "index": 1 } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "llm_probe_success{provider=\"$provider\"}", "refId": "A" }]
    },
    {
      "title": "Uptime 24h",
      "description": "过去 24 小时的探测成功率",
      "type": "stat", "id": 11,
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2, "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "avg_over_time(llm_probe_success{provider=\"$provider\"}[24h])", "refId": "A" }]
    },
    {
      "title": "TTFT",
      "description": "首 Token 延迟均值（从请求发出到收到第一个内容 token）",
      "type": "stat", "id": 12,
      "gridPos": { "h": 4, "w": 2, "x": 6, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "rate(llm_probe_ttft_seconds_sum{provider=\"$provider\"}[$__rate_interval]) / clamp_min(rate(llm_probe_ttft_seconds_count{provider=\"$provider\"}[$__rate_interval]), 1e-10)", "refId": "A" }]
    },
    {
      "title": "Connect",
      "description": "连接建立耗时均值（DNS + TCP + TLS）",
      "type": "stat", "id": 52,
      "gridPos": { "h": 4, "w": 2, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 1000 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "rate(llm_probe_connect_duration_seconds_sum{provider=\"$provider\"}[$__rate_interval]) / clamp_min(rate(llm_probe_connect_duration_seconds_count{provider=\"$provider\"}[$__rate_interval]), 1e-10) * 1000", "refId": "A" }]
    },
    {
      "title": "Duration",
      "description": "完整请求时长均值（从发起请求到流结束）",
      "type": "stat", "id": 13,
      "gridPos": { "h": 4, "w": 2, "x": 10, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "rate(llm_probe_duration_seconds_sum{provider=\"$provider\"}[$__rate_interval]) / clamp_min(rate(llm_probe_duration_seconds_count{provider=\"$provider\"}[$__rate_interval]), 1e-10)", "refId": "A" }]
    },
    {
      "title": "Token Rate",
      "description": "Token 生成速率（output_tokens / 生成时长，tok/s）",
      "type": "stat", "id": 53,
      "gridPos": { "h": 4, "w": 2, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 30 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "llm_probe_token_rate{provider=\"$provider\"}", "legendFormat": "tok/s", "refId": "A" }]
    },
    {
      "title": "In Tokens",
      "description": "最近一次探测的输入 token 数（prompt 消耗）",
      "type": "stat", "id": 54,
      "gridPos": { "h": 4, "w": 2, "x": 14, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "llm_probe_input_tokens{provider=\"$provider\"}", "refId": "A" }]
    },
    {
      "title": "Out Tokens",
      "description": "最近一次探测的输出 token 数（模型生成）",
      "type": "stat", "id": 55,
      "gridPos": { "h": 4, "w": 2, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "llm_probe_output_tokens{provider=\"$provider\"}", "refId": "A" }]
    },
    {
      "title": "Total Tokens",
      "description": "最近一次探测消耗的 token 总数（输入 + 输出）",
      "type": "stat", "id": 56,
      "gridPos": { "h": 4, "w": 2, "x": 18, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-blue", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "llm_probe_total_tokens{provider=\"$provider\"}", "refId": "A" }]
    },
    {
      "title": "Errors",
      "description": "最近 5 分钟内的探测错误次数",
      "type": "stat", "id": 15,
      "gridPos": { "h": 4, "w": 2, "x": 20, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(increase(llm_probe_errors_total{provider=\"$provider\"}[5m])) or vector(0)", "refId": "A" }]
    },
    {
      "title": "Model",
      "description": "当前探测使用的模型名称",
      "type": "stat", "id": 16,
      "gridPos": { "h": 4, "w": 2, "x": 22, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } } },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "llm_probe_success{provider=\"$provider\"}", "legendFormat": "{{ model }}", "refId": "A" }]
    },

    {
      "title": "Request Phases — $provider",
      "description": "请求阶段分解：Connect（DNS+TCP+TLS）→ Wait（等待首 token）→ Generation（token 生成）",
      "type": "timeseries",
      "id": 60,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Connect" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Wait (TTFT - Connect)" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Generation" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "rate(llm_probe_connect_duration_seconds_sum{provider=\"$provider\"}[$__rate_interval]) / clamp_min(rate(llm_probe_connect_duration_seconds_count{provider=\"$provider\"}[$__rate_interval]), 1e-10)",
          "legendFormat": "Connect",
          "refId": "A"
        },
        {
          "expr": "clamp_min((rate(llm_probe_ttft_seconds_sum{provider=\"$provider\"}[$__rate_interval]) / clamp_min(rate(llm_probe_ttft_seconds_count{provider=\"$provider\"}[$__rate_interval]), 1e-10)) - (rate(llm_probe_connect_duration_seconds_sum{provider=\"$provider\"}[$__rate_interval]) / clamp_min(rate(llm_probe_connect_duration_seconds_count{provider=\"$provider\"}[$__rate_interval]), 1e-10)), 0)",
          "legendFormat": "Wait (TTFT - Connect)",
          "refId": "B"
        },
        {
